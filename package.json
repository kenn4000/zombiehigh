{
  "name": "zombie-high",
  "version": "1.0.0",
  "description": "Zombie High - multiplayer hex board game",
  "scripts": {
    "sim:batch": "ts-node src/scripts/run-cpu-simulation-batch.ts",
    "sim": "tsx src/scripts/run-cpu-simulation.ts --players=3 --max-steps=300",
    "sim:2": "tsx src/scripts/run-cpu-simulation.ts --players=2 --max-steps=2000",
    "sim:5": "tsx src/scripts/run-cpu-simulation.ts --players=5 --max-steps=10000",
    "dev": "concurrently --names SRV,CLT --prefix-colors cyan,yellow \"tsx watch src/server/server.ts\" \"webpack serve --config webpack.config.js\"",
    "build:server": "tsc --project tsconfig.server.json",
    "build:client": "webpack --config webpack.config.js",
    "build": "npm run build:server && npm run build:client",
    "clean": "npx rimraf build dist",
    "test": "mocha --require tsx/cjs 'tests/**/*.test.ts'",
    "test:multiplayer-playtest": "mocha --require tsx/cjs tests/multiplayer-action-playtest.test.ts",
    "start": "node build/server/server/server.js"
  },
  "dependencies": {
    "@vue/runtime-dom": "^3.5.40",
    "@vueuse/core": "^14.3.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "three": "^0.185.1",
    "three-stdlib": "^2.36.1",
    "uuid": "^9.0.0",
    "vue": "^3.5.40",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/chai": "^4.3.11",
    "@types/express": "^4.17.21",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.19.43",
    "@types/three": "^0.185.1",
    "@types/uuid": "^9.0.7",
    "@types/webpack-env": "^1.18.8",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-sfc": "^3.5.40",
    "chai": "^4.3.10",
    "concurrently": "^9.2.1",
    "css-loader": "^6.8.1",
    "html-webpack-plugin": "^5.6.7",
    "mocha": "^10.2.0",
    "style-loader": "^3.3.3",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vue-loader": "^17.4.2",
    "vue-style-loader": "^4.1.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.2"
  }
}
